# 1. Rename this file to ".env" by removing the ".example" extension
# 2. Replace "HF_TOKEN" value with your actual HuggingFace token

# Use-Case
MEMDEC_USECASE='legal_usecase'          # switch to any usecase-folder in config/

# Global Base LLM (optional: "config/{usecase}/pipeline_config.yaml" can override if set)
MEMDEC_MODEL='gemma3'                   # options: gemma3, qwen3.5, smollm3

# HuggingFace Token (required for gated OpenLegalData dataset)
HF_TOKEN='hf_token'                     # https://huggingface.co/settings/tokens